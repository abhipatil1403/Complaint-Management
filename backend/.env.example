# AICTE OneDesk API configuration (server-side only).
#
# Copy this file to backend/.env and fill in values locally. Never commit the
# filled file, and never expose DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY or a JWT
# secret to the browser bundle.
#
# The FastAPI service talks to PostgreSQL directly; the browser only receives the
# Supabase URL and the public anon key (see frontend/.env.example).

APP_ENV=local
DEMO_MODE=true
DEMO_BANNER_TEXT=Illustrative Demo Data - simulated environment

# --- Supabase Auth ---------------------------------------------------------
# Token verification uses the project JWKS endpoint derived from SUPABASE_URL.
# Set SUPABASE_JWKS_URL only when the project uses a custom endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=
# Legacy symmetric secret. Preferred only when the project still issues HS256
# access tokens; the project URL + JWKS is the default for new projects.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_ALGORITHMS=RS256,ES256,HS256
SUPABASE_ALLOWED_TOKEN_ROLES=authenticated

# --- Database --------------------------------------------------------------
# Server-side PostgreSQL connection string. Use the Supabase `postgres` role (or
# another role allowed to SET LOCAL ROLE authenticated) so row level security is
# evaluated for the caller instead of bypassed by a table owner.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_RLS_ROLE=authenticated
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT=10

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_ID_HEADER=X-Request-ID
