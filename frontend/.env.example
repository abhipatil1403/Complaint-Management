# Frontend configuration (Vite).
#
# Only the Supabase URL and the *anon* key belong in the browser bundle.
# Never add a service-role key, database URL or JWT secret here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the FastAPI service.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google Gemini API key for live AI Case Triage & Regulatory Synopsis
VITE_GEMINI_API_KEY=your-gemini-api-key-here
